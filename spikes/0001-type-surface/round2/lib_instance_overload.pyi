# ^ Finding L1 of the write-up (field specifiers solve T from the annotation only).
"""Column-as-value follow-up: the instance overload of `Col.__get__` (`object` vs `Entity`)."""

from typing import Literal, Never, dataclass_transform, overload

class Pred[O]: ...
class Op[O]: ...

class Column[O, T]:
    def to(self, value: T, /) -> Op[O]: ...
    def ge_value(self, other: T, /) -> Pred[O]: ...
    def ge_value_or_column(self, other: T | Column[O, T], /) -> Pred[O]: ...

class Entity:
    def __init_subclass__(cls, *, table: str) -> None: ...

class ColWide[T]:
    """Instance overload on `object`, as in lib_final.pyi."""

    @overload
    def __get__[O](self, instance: None, owner: type[O], /) -> Column[O, T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

class ColEntity[T]:
    """Instance overload narrowed to `Entity`, so it cannot match `None`."""

    @overload
    def __get__[O](self, instance: None, owner: type[O], /) -> Column[O, T]: ...
    @overload
    def __get__(self, instance: Entity, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

def col_wide[T](*, init: Literal[True] = True) -> ColWide[T]: ...
def col_entity[T](*, init: Literal[True] = True) -> ColEntity[T]: ...
@dataclass_transform(frozen_default=True, field_specifiers=(col_wide, col_entity))
def value[C](cls: type[C], /) -> type[C]: ...
