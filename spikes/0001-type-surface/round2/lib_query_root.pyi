"""P-A follow-up S3: a query whose root entity is explicit, columns added per joined entity."""

from lib_final import Expr, OwnedExpr, Pred, Relation

class Query[R, O]:
    def join[E](self, relation: Relation[O, E], /, *, outer: bool = ...) -> Query[R, O | E]: ...
    def where(self, *preds: Pred[O]) -> Query[R, O]: ...
    def columns(self, **columns: OwnedExpr[O] | Expr) -> Query[R, O]: ...

def select_root[R, O](dto: type[R], root: type[O], /, **columns: OwnedExpr[O]) -> Query[R, O]: ...
