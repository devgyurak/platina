# pyright: reportInvalidTypeVarUse=false
# ^ Finding L1 of the write-up (field specifiers solve T from the annotation only).
"""Follow-up F1: a column that carries its owner class, `Column[O, T]`."""

from collections.abc import Callable
from typing import Literal, Never, Self, dataclass_transform, overload

class Pred: ...

class Op[O]:
    """A field operation on an entity of type O."""

class Column[O, T]:
    def to(self, value: T, /) -> Op[O]: ...
    def add(self, delta: T, /) -> Op[O]: ...
    def __ge__(self, other: T, /) -> Pred: ...
    def path[U](self, field: Column[T, U], /) -> Column[O, U]: ...

class Col[T]:
    @overload
    def __get__[O](self, instance: None, owner: type[O], /) -> Column[O, T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

def column[T](*, init: Literal[True] = True) -> Col[T]: ...

@dataclass_transform(kw_only_default=True, field_specifiers=(column,))
class Entity:
    def __init_subclass__(cls, *, table: str) -> None: ...
    @classmethod
    def new[**P, S](cls: Callable[P, S], *args: P.args, **kwargs: P.kwargs) -> S: ...
    def set(self, *ops: Op[Self]) -> None: ...

@dataclass_transform(frozen_default=True, order_default=True, field_specifiers=(column,))
def value[C](cls: type[C], /) -> type[C]: ...

class Repository[E]: ...

class BoundFinder[E, T]:
    def __call__(self, value: T, /) -> E: ...

class Finder[E, T]:
    def __init__(self, column: Column[E, T], /) -> None: ...
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Self: ...
    @overload
    def __get__(self, instance: Repository[E], owner: type[object], /) -> BoundFinder[E, T]: ...
