# F3, copied from the round-1 reproducer's rp_delta.pyi: item 4(d) alternative: delta type read structurally through a Protocol.
from typing import Never, Protocol, overload

class Op: ...

class Additive[D]:
    """Invariant in D on purpose (D is both a parameter and a return type)."""
    def __delta__(self, d: D, /) -> D: ...

class _HasDelta[D](Protocol):
    @property
    def _of(self) -> Additive[D]: ...

class Column[T]:
    @property
    def _of(self) -> T: ...
    def to(self, v: T, /) -> Op: ...
    @overload
    def add[D](self: _HasDelta[D], n: D, /) -> Op: ...
    @overload
    def add(self, n: T, /) -> Op: ...

class Col[T]:
    @overload
    def __get__(self, obj: None, cls: type, /) -> Column[T]: ...
    @overload
    def __get__(self, obj: object, cls: type, /) -> T: ...
    def __set__(self, obj: Never, v: T, /) -> None: ...
