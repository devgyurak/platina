# pyright: reportInvalidTypeVarUse=false
# ^ Finding L1 of the write-up: field specifiers without a value (`column()`, `pk()`, `fk()`, ...)
#   solve T from the annotation only, which pyright strict rejects in the library itself.
"""Spike 0001: the public type surface of design section 4, signatures only.

Throwaway. Every signature here is the smallest one that expresses what section 4 promises; where
the design leaves a signature open, the choice is named in the write-up.
"""

from collections.abc import Callable, Sequence
from datetime import datetime
from typing import Annotated, Literal, Never, Self, dataclass_transform, overload
from uuid import UUID

# --------------------------------------------------------------------------- expressions
class Expr:
    def desc(self) -> Expr: ...

class Pred(Expr): ...

class Op:
    """A field operation passed to `.set(...)` (`Order.status.to(v)`, `Wallet.balance.add(n)`)."""

class Column[T](Expr):
    """Class access of a `Col[T]` field (`Order.status`)."""

    def to(self, value: T, /) -> Op: ...
    def add(self, delta: T, /) -> Op: ...
    def __eq__(self, other: T, /) -> Pred: ...  # type: ignore[override]  # finding L2
    def __ne__(self, other: T, /) -> Pred: ...  # type: ignore[override]  # finding L2
    def __lt__(self, other: T, /) -> Pred: ...
    def __ge__(self, other: T, /) -> Pred: ...

class Relation[E](Expr):
    """Class access of a collection relation (`Order.items`)."""

    def add(self, item: E, /) -> Op: ...
    def remove(self, item: E, /) -> Op: ...
    def update(self, item: E, /, *ops: Op) -> Op: ...
    def count(self) -> Expr: ...

class RelColumn[T](Expr):
    """Class access of a single-valued relation (`Order.user`)."""

# --------------------------------------------------------------------------- field descriptors
class Col[T]:
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Column[T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

class Rel[T]:
    @overload
    def __get__[E](self: Rel[list[E]], instance: None, owner: type[object], /) -> Relation[E]: ...
    @overload
    def __get__[E](self: Rel[list[E]], instance: object, owner: type[object], /) -> Sequence[E]: ...
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> RelColumn[T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

class Id[E](UUID): ...

# --------------------------------------------------------------------------- field specifiers
@overload
def column[T](
    *,
    default: T,
    unique: bool = ...,
    length: int | None = ...,
    enum_as: Literal["text", "native"] = ...,
) -> Col[T]: ...
@overload
def column[T](
    *,
    server_default: Expr,
    init: Literal[False] = False,
    unique: bool = ...,
    length: int | None = ...,
) -> Col[T]: ...
@overload
def column[T](
    *,
    unique: bool = ...,
    length: int | None = ...,
    enum_as: Literal["text", "native"] = ...,
) -> Col[T]: ...
def pk[T](
    *, generated: Literal["uuid7", "identity"] = ..., init: Literal[False] = False
) -> Col[T]: ...
def fk[T](target: Callable[[], type[object]], /) -> Col[T]: ...
def embedded[T](*, prefix: str) -> Col[T]: ...
def version_column(*, init: Literal[False] = False) -> Col[int]: ...
def many_to_one[T](*, via: Callable[[], Expr], init: Literal[False] = False) -> Rel[T]: ...
def one_to_many[T](
    target: Callable[[], Expr],
    /,
    *,
    owned: bool = ...,
    order_by: Callable[[], Expr] | None = ...,
    init: Literal[False] = False,
) -> Rel[T]: ...
def server_now() -> Expr: ...

# --------------------------------------------------------------------------- changes
class Changes:
    def __add__(self, other: Changes, /) -> Changes: ...
    def returning(self, value: object, /) -> Changes: ...

class SetChange(Changes):
    def set(self, *ops: Op) -> SetChange: ...
    def emit_each(self, event: type[object], /, **fields: Expr) -> SetChange: ...

class StepResult:
    """What calling a use case or a step directly returns (design 4.12). Has no `+`."""

    @property
    def events(self) -> Sequence[object]: ...

def emit(event: object, /) -> Changes: ...

# --------------------------------------------------------------------------- entity declaration
# The design form (4.2): a class decorator, no base class.
@dataclass_transform(
    kw_only_default=True,
    field_specifiers=(column, pk, fk, embedded, version_column, many_to_one, one_to_many),
)
def entity[C](*, table: str, aggregate_root: bool = ...) -> Callable[[type[C]], type[C]]: ...

# Variant tested when the decorator alone does not expose the members (item 0): a base class.
@dataclass_transform(
    kw_only_default=True,
    field_specifiers=(column, pk, fk, embedded, version_column, many_to_one, one_to_many),
)
class Entity:
    def __init_subclass__(cls, *, table: str, aggregate_root: bool = ...) -> None: ...
    @classmethod
    def new[**P, S](cls: Callable[P, S], *args: P.args, **kwargs: P.kwargs) -> S: ...
    @classmethod
    def ref(cls, id: UUID, /, *, expected_version: int | None = ...) -> Self: ...
    @classmethod
    def where(cls, *preds: Pred) -> SetChange: ...
    @classmethod
    def stub(cls, **fields: object) -> Self: ...
    def set(self, *ops: Op, unsafe_bypass: str | None = ...) -> Changes: ...

def invariant[F](*, fields: Callable[[], tuple[Expr, ...]]) -> Callable[[F], F]: ...

class Index:
    def __init__(self, columns: Callable[[], tuple[Expr, ...]], /) -> None: ...

class Check:
    def __init__(self, predicate: Callable[[], Pred], /) -> None: ...

@dataclass_transform(frozen_default=True, order_default=True)
def value[C](cls: type[C], /) -> type[C]: ...
@dataclass_transform(kw_only_default=True, field_specifiers=())
def event[C](*, aggregate: Callable[[], Expr]) -> Callable[[type[C]], type[C]]: ...
@dataclass_transform(kw_only_default=True)
def dto[C](cls: type[C], /) -> type[C]: ...

# --------------------------------------------------------------------------- repositories
class Repository[E]: ...

class Profile(Expr):
    def __init__(self, *fields: Expr, lock: Literal["for_update"] | None = ...) -> None: ...

class Load:
    def __init__(self, *fields: Expr) -> None: ...

class BoundFinder[E, T]:
    def __call__(self, value: T, /) -> E: ...

class Finder[T]:
    def __init__(self, column: Column[T], /) -> None: ...
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Self: ...
    @overload
    def __get__[E](self, instance: Repository[E], owner: type[object], /) -> BoundFinder[E, T]: ...

class Select[R]:
    def join(self, relation: Expr, /, *, outer: bool = ...) -> Self: ...
    def where(self, *preds: Pred) -> Self: ...
    def group_by(self, *columns: Expr) -> Self: ...
    def order_by(self, *columns: Expr) -> Self: ...
    def limit(self, n: int, /) -> Self: ...

def select[R](dto: type[R], /, **columns: Expr) -> Select[R]: ...
def count(column: Expr, /) -> Expr: ...
def query[F: Callable[..., object]](fn: F, /) -> F: ...

# --------------------------------------------------------------------------- use cases
class _Injected: ...

INJECTED: Never
type Now = Annotated[datetime, _Injected]

class Bound:
    """A run description: what `uc.bind(...)` returns and `app.run` executes."""

class Usecase[**P]:
    def bind(self, *args: P.args, **kwargs: P.kwargs) -> Bound: ...
    def __call__(self, *args: P.args, **kwargs: P.kwargs) -> StepResult: ...

class Step[**P]:
    def __call__(self, *args: P.args, **kwargs: P.kwargs) -> StepResult: ...

class Retry:
    def __init__(
        self,
        *,
        max_attempts: int = ...,
        base_ms: int = ...,
        cap_ms: int = ...,
        on_unique: bool = ...,
    ) -> None: ...

@overload
def usecase[**P](fn: Callable[P, Changes], /) -> Usecase[P]: ...
@overload
def usecase[**P](
    *,
    isolation: Literal["serializable", "repeatable_read"] = ...,
    retry: Retry | None = ...,
    timeout: str | None = ...,
) -> Callable[[Callable[P, Changes]], Usecase[P]]: ...
def step[**P](fn: Callable[P, Changes], /) -> Step[P]: ...
def then(bound: Bound, /) -> Changes: ...

class Chain:
    def run[**P](
        self, fn: Callable[P, StepResult], /, *args: P.args, **kwargs: P.kwargs
    ) -> None: ...
    @property
    def changes(self) -> Changes: ...
    def original[E](self, view: E, /) -> E: ...

class ChainBlock[*Ts]:
    def __enter__(self) -> tuple[Chain, *Ts]: ...
    def __exit__(self, *exc: object) -> None: ...

def chain[*Ts](*snapshots: *Ts) -> ChainBlock[*Ts]: ...

# --------------------------------------------------------------------------- app
class ConsistencyToken: ...

class RunResult:
    @property
    def run_id(self) -> UUID: ...
    @property
    def token(self) -> ConsistencyToken: ...
    @property
    def events(self) -> Sequence[object]: ...
    @property
    def value(self) -> object: ...

class App:
    def __init__(self, *, dsn: str, modules: Sequence[str] = ...) -> None: ...
    def seal(self) -> None: ...
    async def run(
        self,
        bound: Bound,
        /,
        *,
        idempotency_key: str | None = ...,
        after: ConsistencyToken | None = ...,
        # design 4.5 also lists `timeout`; ruff ASYNC109 flags it on an async def (note L3)
    ) -> RunResult: ...
    async def query[R](
        self, q: Select[R], /, *, after: ConsistencyToken | None = ...
    ) -> list[R]: ...
