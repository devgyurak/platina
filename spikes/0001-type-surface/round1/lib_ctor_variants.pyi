"""Item 2 alternatives: frozen dataclass vs `__set__` variants."""

from typing import Literal, Never, dataclass_transform, overload

class Column[T]: ...

class ColNoSet[T]:
    """No __set__: a non-data descriptor."""

    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Column[T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...

class ColNeverSet[T]:
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Column[T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: Never, value: T, /) -> None: ...

class ColObjectSet[T]:
    @overload
    def __get__(self, instance: None, owner: type[object], /) -> Column[T]: ...
    @overload
    def __get__(self, instance: object, owner: type[object], /) -> T: ...
    def __set__(self, instance: object, value: T, /) -> None: ...

def field[C](*, init: Literal[True] = True) -> C: ...

@dataclass_transform(kw_only_default=True, frozen_default=True, field_specifiers=(field,))
class FrozenBase: ...

@dataclass_transform(kw_only_default=True, field_specifiers=(field,))
class PlainBase: ...
